# Copy to a root-owned path outside Git. Never commit the populated file.
COMPOSE_PROJECT_NAME=advisor-production
APP_ENV=production
POSTGRES_IMAGE=postgres:17-alpine@sha256:REPLACE_WITH_REVIEWED_DIGEST
API_IMAGE=registry.example.edu.vn/student-advisor-api
API_IMAGE_DIGEST=sha256:REPLACE_WITH_RELEASE_DIGEST
WEB_IMAGE=registry.example.edu.vn/student-advisor-web
WEB_IMAGE_DIGEST=sha256:REPLACE_WITH_RELEASE_DIGEST
ADMIN_DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
MIGRATOR_DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
APP_DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ALLOWED_HOSTS=advisor.example.edu.vn
CORS_ALLOWED_ORIGINS=https://advisor.example.edu.vn
EDGE_SUBNET=172.30.0.0/24
WEB_PROXY_IP=172.30.0.2
API_INTERNAL_IP=172.30.0.3
TRUSTED_PROXY_IPS=172.30.0.2
WEB_BIND=127.0.0.1:8080
ARTIFACTS_PATH=/srv/student-advisor/artifacts
RAG_METHOD=keyword
RAG_LLM_ENABLED=0
RAG_LLM_PROVIDER=gemini
GEMINI_API_KEY=
RAG_LLM_GATEWAY_URL=
RAG_LLM_GATEWAY_SECRET=
RAG_LLM_MODEL=gemini-3.5-flash-lite
RAG_LLM_TIMEOUT_SECONDS=20
RAG_LLM_PROMPT_VERSION=decision_tree_stage7/1
RAG_RUNTIME_APPROVAL_PATH=/artifacts/stage7/benchmark_v4/rag_runtime_approval_capstone_v4.signed.json
RAG_HIGH_STAKES_APPROVAL_PATH=/artifacts/stage7/benchmark_v4/rag_high_stakes_grounded_capstone_v4.signed.json
RAG_RELEASE_RECEIPT_PATH=/artifacts/stage7/effectivity/release_receipt.current.json
