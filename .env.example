# Generate actual local secrets using ops/Initialize-Local.ps1. Never commit .env.
COMPOSE_PROJECT_NAME=sic-student-advisor
API_IMAGE_TAG=foundation
ADMIN_DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
MIGRATOR_DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
APP_DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
WEB_PORT=3000
API_PORT=8000
# Optional citation-constrained generation. Keep disabled until provider/data use is approved.
RAG_LLM_ENABLED=0
RAG_LLM_PROVIDER=
GEMINI_API_KEY=
RAG_LLM_BASE_URL=
RAG_LLM_MODEL=
RAG_LLM_API_KEY=
RAG_LLM_TIMEOUT_SECONDS=20
# Must match the reviewed runtime approval before UTT generation is enabled.
RAG_LLM_PROMPT_VERSION=decision_tree_stage7/1
RAG_RUNTIME_APPROVAL_PATH=/artifacts/stage7/benchmark_v4/rag_runtime_approval_capstone_v4.signed.json
RAG_HIGH_STAKES_APPROVAL_PATH=/artifacts/stage7/benchmark_v4/rag_high_stakes_grounded_capstone_v4.signed.json
RAG_RELEASE_RECEIPT_PATH=/artifacts/stage7/effectivity/release_receipt.current.json
